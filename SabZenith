local function clearHL(p2)
    if p2.Character then
        local hl = p2.Character:FindFirstChild("ZHL")
        if hl then hl:Destroy() end
    end
    if espBBs[p2] then espBBs[p2]:Destroy(); espBBs[p2] = nil end
end

